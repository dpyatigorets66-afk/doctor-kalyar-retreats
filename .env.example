# Telegram-бот Real Yoga. Скопируйте в .env и заполните первые две строки.
# Остальные значения — безопасные по умолчанию, менять без нужды не стоит.

# Токен от @BotFather
BOT_TOKEN=
# Числовые id админов через запятую (свой id подскажет @userinfobot)
ADMIN_IDS=

DB_PATH=data/bot.sqlite3
TIMEZONE=Asia/Bangkok
# Во сколько (по TIMEZONE) присылать админам ежедневную сводку
SUMMARY_HOUR=21
# Отвечать можно только тому, кто сам писал за последние N часов
REPLY_WINDOW_HOURS=24

# --- C. Рассылки подписчикам бота
# Не чаще одной рассылки в N дней на человека
BROADCAST_MIN_DAYS=3
# Если после рассылки бота заблокировали больше этой доли получателей — следующая рассылка блокируется
BROADCAST_MAX_BLOCK_RATE=0.03

# --- D. Касание клиентской базы (Telethon-аккаунт)
# Первые N дней аккаунт только читает и отвечает
OUTREACH_WARMUP_DAYS=7
# Первых сообщений в день: неделя 1 после прогрева, неделя 2, дальше максимум
OUTREACH_WEEK1_LIMIT=5
OUTREACH_WEEK2_LIMIT=10
OUTREACH_DAILY_LIMIT=20
# Случайная пауза между сообщениями, минуты
OUTREACH_MIN_GAP_MIN=4
OUTREACH_MAX_GAP_MIN=12
# Рабочие часы по TIMEZONE: с OUTREACH_HOUR_START:00 до OUTREACH_HOUR_END:00, в воскресенье не пишем
OUTREACH_HOUR_START=10
OUTREACH_HOUR_END=19
OUTREACH_MAX_LEN=300
OUTREACH_MAX_EMOJI=2
# Текст похож больше чем на эту долю на любое из последних N отправленных — переписать
OUTREACH_SIMILARITY_MAX=0.70
OUTREACH_SIMILARITY_WINDOW=50
# Больше N «стоп» за день — касания на паузу до ручного включения
OUTREACH_STOP_PAUSE_THRESHOLD=2
# Пауза аккаунта после PeerFloodError / FloodWaitError, часы
FLOOD_PAUSE_HOURS=48

# --- E. Ответы в группах Пхукета
# Отвечаем только на вопросы с оценкой модели не ниже N из 10
SCOUT_MIN_SCORE=8
SCOUT_DAILY_LIMIT=10
SCOUT_PER_GROUP_DAILY=1
# Без кнопки админа не отправлять. Не включать.
SCOUT_AUTOPILOT=false
GROUP_JOIN_DAILY_LIMIT=2
